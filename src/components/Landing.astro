---
import { Icon } from 'astro-icon/components';
import Boot from './Boot.astro';
import WaveField from './WaveField.astro';
import Wordmark from './Wordmark.astro';
import Ticker from './Ticker.astro';
import { copy, tickerLabels } from '../copy';
import { contactHref, contactLabel, isContactSet, social } from '../site.config';

const href = contactHref();
const label = contactLabel();

const profileLabel = { github: copy.github, linkedin: copy.linkedin } as const;

const buildYear = new Date().getFullYear();
---

<WaveField alt={copy.fieldAlt} staticLabel={copy.fieldStatic} />

<a class="skip plate label" href="#contact">{copy.skip}</a>

<div class="shell">
  <header class="rail rail--top">
    <!-- The rail's left anchor is the world's material, not the name: the
         wordmark is on screen at full size directly below, and repeating it
         in the corner is duplication, not branding. -->
    <span class="mark" aria-hidden="true"><span class="cap"></span></span>

    <div class="controls">
      <!-- Theme takes the slot the language toggle held. It is not an on/off
           toggle, so it carries no `aria-pressed`: the hidden suffix names the
           ACTION and the mark shows the theme you would move to. State the page
           already displays does not need to be announced twice. -->
      <button class="plate plate--icon label" type="button" data-theme-toggle>
        <span class="plate__ico">
          <Icon name="material-symbols:light-mode-sharp" data-when="to-light" aria-hidden="true" />
          <Icon name="material-symbols:dark-mode-sharp" data-when="to-dark" aria-hidden="true" />
        </span>
        <span class="plate__reveal"><span class="plate__word"><span class="plate__text">{copy.themeLabel}</span></span></span>
        <span class="visually-hidden">, <span data-theme-state>{copy.themeToLight}</span></span>
      </button>

      <!-- The printed word is folded to zero width until hover or focus asks
           for it; it stays in the accessibility tree throughout, so the
           accessible name reads "Motion, running" whether or not anyone is
           pointing at it. The mark alone carries the state visually, which is
           why the word can afford to be a fixed noun. -->
      <button
        class="plate plate--icon label"
        type="button"
        data-motion
        aria-pressed="false"
        data-state-on={copy.motionHeld}
        data-state-off={copy.motionRunning}
      >
        <span class="plate__ico">
          <Icon name="material-symbols:pause-sharp" data-when="off" aria-hidden="true" />
          <Icon name="material-symbols:play-arrow-sharp" data-when="on" aria-hidden="true" />
        </span>
        <span class="plate__reveal"><span class="plate__word"><span class="plate__text">{copy.motionLabel}</span></span></span>
        <span class="visually-hidden">, <span data-motion-state>{copy.motionRunning}</span></span>
      </button>

      <!-- Sound is off until asked for. The volume control only exists once
           there is something to set the level of. -->
      <div class="sound">
        <button
          class="plate plate--icon label"
          type="button"
          data-sound
          aria-pressed="false"
          data-state-on={copy.soundPlaying}
          data-state-off={copy.soundSilent}
        >
          <span class="plate__ico">
            <Icon name="material-symbols:volume-off-sharp" data-when="off" aria-hidden="true" />
            <Icon name="material-symbols:volume-up-sharp" data-when="on" aria-hidden="true" />
          </span>
          <span class="plate__reveal"><span class="plate__word"><span class="plate__text">{copy.soundLabel}</span></span></span>
          <span class="visually-hidden">, <span data-sound-state>{copy.soundSilent}</span></span>
        </button>

        <label class="volume" data-volume-wrap hidden>
          <span class="visually-hidden">{copy.soundVolume}</span>
          <input type="range" min="0" max="100" value="55" step="1" data-volume />
        </label>
      </div>
    </div>
  </header>

  <!-- The margin column. Every value here is sampled from the mesh on screen:
       a rolling history of its measured amplitude, not an invented metric. -->
  <aside class="readout" aria-hidden="true">
    <span class="label label--quiet readout__title">{copy.fieldReadout}</span>
    <ol class="readout__stack" data-readout-stack>
      {Array.from({ length: 9 }).map(() => <li class="readout__row label label--quiet">–.–––––</li>)}
    </ol>
  </aside>

  <main class="stage">
    <Wordmark label="fltr" />

    <div class="contact" id="contact">
      {
        isContactSet ? (
          <>
            <a class="plate label" href={href!} data-contact-link>
              <span class="cap" />
              <span>{label}</span>
            </a>
            <button class="plate label" type="button" data-copy={label} data-copied={copy.contactCopied}>
              <span data-copy-text>{copy.contactCopy}</span>
            </button>
          </>
        ) : (
          <p class="unset label">
            <span class="unset__box" aria-hidden="true" />
            <Ticker labels={tickerLabels} accessibleLabel={copy.contactUnset} />
          </p>
        )
      }
    </div>
  </main>

  <footer class="rail rail--bottom">
    <!-- The profiles anchor the foot rail's left edge, the same corner the top
         rail anchors with the barcode mark. They are the only outbound links on
         the page and the only real evidence it carries, so they sit in the
         chrome, not in the stage: the wordmark keeps the stage to itself. -->
    <nav class="social" aria-label={copy.profiles}>
      {
        social.map((profile) => (
          <a
            class="plate plate--icon label"
            href={profile.href}
            target="_blank"
            rel="me noopener noreferrer"
          >
            <span class="plate__ico">
              <Icon name={profile.icon} aria-hidden="true" />
            </span>
            <span class="plate__reveal">
              <span class="plate__word">
                <span class="plate__text">{profileLabel[profile.key]}</span>
              </span>
            </span>
          </a>
        ))
      }
    </nav>

    <!-- Baked at build time, which for a static site means the year the page
         was last built rather than the year it is being read. That is what a
         copyright notice is supposed to say, and it is why this is not a
         client-side `getFullYear()`: a notice that silently rewrites itself in
         the reader's browser asserts a date nobody published. -->
    <small class="copyright label label--quiet">© {buildYear} {copy.copyrightHolder}</small>

    <span class="bars" aria-hidden="true"></span>
    <dl class="meters">
      <div class="meter">
        <dt class="label label--quiet">{copy.fieldAmplitude}</dt>
        <dd class="label" data-meter-amp>–.––</dd>
      </div>
      <div class="meter">
        <dt class="label label--quiet">{copy.fieldNodes}</dt>
        <dd class="label" data-meter-nodes>–</dd>
      </div>
      <div class="meter">
        <dt class="label label--quiet">{copy.fieldFrame}</dt>
        <dd class="label" data-meter-frame>–</dd>
      </div>
    </dl>
  </footer>
</div>

<!-- Last in the source, first on screen. It covers the shell above rather than
     replacing it: the landing paints underneath and is fully laid out by the
     time the cover lifts, so the reveal has nothing left to do. -->
<Boot />

<style>
  .shell {
    position: relative;
    z-index: var(--z-shell);
    min-block-size: 100svb;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  /* ── Rails ─────────────────────────────────────────────────────────────── */
  .rail {
    display: flex;
    align-items: center;
    gap: var(--gutter);
    padding-inline: var(--gutter);
    min-block-size: 3rem;
  }

  .rail--top {
    justify-content: space-between;
    border-block-end: var(--rule);
  }

  .rail--bottom {
    justify-content: space-between;
    border-block-start: var(--rule);
    gap: calc(var(--gutter) / 2);
  }

  .mark {
    display: inline-flex;
    align-items: center;
    block-size: 0.875rem;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: calc(var(--gutter) / 2);
  }

  /* ── Sound ─────────────────────────────────────────────────────────────── */
  .sound {
    display: flex;
    align-items: stretch;
    gap: calc(var(--gutter) / 3);
  }

  .volume {
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    border: var(--rule);
  }

  /* `display` beats the hidden attribute, so a flex element with [hidden] stays
     on screen. Without this line the volume control is visible while the sound
     is still off. */
  .volume[hidden] {
    display: none;
  }

  /* The range is themed rather than replaced: a hairline track and a filled
     block for the thumb, which is this world's cursor shape. Native input,
     native keyboard behaviour. */
  .volume input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    inline-size: 4.5rem;
    background: transparent;
    margin: 0;
    cursor: pointer;
  }

  .volume input[type='range']::-webkit-slider-runnable-track {
    block-size: 1px;
    background: var(--signal);
  }

  .volume input[type='range']::-moz-range-track {
    block-size: 1px;
    background: var(--signal);
  }

  .volume input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    inline-size: 0.5rem;
    block-size: 0.875rem;
    margin-block-start: -0.4375rem;
    background: var(--signal);
    border: none;
    border-radius: 0;
  }

  .volume input[type='range']::-moz-range-thumb {
    inline-size: 0.5rem;
    block-size: 0.875rem;
    background: var(--signal);
    border: none;
    border-radius: 0;
  }

  .volume input[type='range']:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 4px;
  }

  /* ── Margin readout ────────────────────────────────────────────────────── */
  .readout {
    position: absolute;
    inset-block-start: calc(3rem + var(--gutter));
    inset-inline-start: var(--gutter);
    display: grid;
    gap: 0.55rem;
  }

  .readout__title {
    padding-block-end: 0.35rem;
    border-block-end: var(--rule-dashed);
  }

  .readout__stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.34rem;
  }

  /* ── Stage: low and left, never centred ────────────────────────────────── */
  .stage {
    align-self: end;
    display: grid;
    justify-items: start;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    padding: var(--gutter);
    padding-block-end: clamp(2rem, 6vh, 4.5rem);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .contact .plate {
    text-decoration: none;
  }

  /* The unshipped state, made loud on purpose: a blank contact must not slip
     past unnoticed on a page whose whole job includes carrying one. */
  .unset {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.625rem 0.875rem;
    border: var(--rule-dashed);
  }

  .unset__box {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border: var(--rule);
  }

  /* ── Foot ──────────────────────────────────────────────────────────────── */
  .social {
    display: flex;
    align-items: center;
    gap: calc(var(--gutter) / 3);
    flex: none;
  }

  .social a {
    text-decoration: none;
  }

  .copyright {
    flex: none;
  }

  .bars {
    flex: 1 1 auto;
    block-size: 0.75rem;
    min-inline-size: 4rem;
    background-image: repeating-linear-gradient(
        to right,
        var(--signal) 0 1px,
        transparent 1px 5px
      ),
      repeating-linear-gradient(to right, var(--signal) 0 1px, transparent 1px 17px);
  }

  .meters {
    display: flex;
    gap: var(--gutter);
    margin: 0;
  }

  .meter {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .meter dd {
    margin: 0;
    font-weight: 700;
  }

  @media (max-width: 47.99rem) {
    .readout {
      display: none;
    }
  }

  /* The readout is absolutely positioned from the top while the stage is
     anchored to the bottom, so on a short viewport the two walk into each
     other — at 620px tall the last rows sit behind the wordmark. Height, not
     width, is the axis that breaks it, and the fix is to print fewer rows
     rather than to drop the column: the rolling history is texture, and four
     samples carry it as well as nine. */
  @media (max-height: 47.99rem) {
    .readout__row:nth-child(n + 5) {
      display: none;
    }
  }

  /* Below this the four rows still reach the wordmark — measured, not guessed:
     at 560px tall the column ends at 170 and the mark starts at 159. There is
     no row count that survives, so the column goes. */
  @media (max-height: 38rem) {
    .readout {
      display: none;
    }
  }

  /* The third meter waits for real width. The copyright notice took about
     180px out of this rail, and at 768 the row was overflowing with all three
     still printed — the bar graphic cannot give it back, since it holds a 4rem
     floor. Dropping the frame counter earlier is cheaper than squashing it. */
  @media (max-width: 61.99rem) {
    .meter:last-child {
      display: none;
    }
  }

  /* Narrow: the icon plates already print at their collapsed width, so the top
     rail needs nothing but a tighter gutter. The foot rail gives up its bar
     graphic and its second meter.

     The foot must NOT be allowed to wrap. The shell is `100svb` with the stage
     on a `1fr` row, and a grid row's automatic minimum is its min-content — the
     wordmark's own height — so a foot that grows a second line does not compress
     the stage, it pushes the whole page past the viewport, and `overflow:
     hidden` on the body eats the difference. Shedding a meter is cheap; the
     meters are aria-hidden readouts. The profiles are real content and stay. */
  @media (max-width: 34rem) {
    .rail {
      gap: calc(var(--gutter) / 2);
    }

    .bars {
      display: none;
    }

    /* The meters go, not the notice. They are aria-hidden readouts of the field
       — texture, and the field is already on screen saying the same thing. The
       copyright is the only real content in this rail besides the profiles, and
       real content outranks texture when the row runs out of width. */
    .meters {
      display: none;
    }
  }
</style>

<script>
  const fmt = (n: number, d = 5) => n.toFixed(d).padStart(8, ' ').replace(/ /g, ' ');

  const stack = document.querySelector<HTMLElement>('[data-readout-stack]');
  const rows = stack ? Array.from(stack.querySelectorAll<HTMLElement>('.readout__row')) : [];
  const amp = document.querySelector<HTMLElement>('[data-meter-amp]');
  const nodesEl = document.querySelector<HTMLElement>('[data-meter-nodes]');
  const frameEl = document.querySelector<HTMLElement>('[data-meter-frame]');

  const history: number[] = [];

  document.addEventListener('fltr:readout', (event) => {
    const { amplitude, nodes, frame } = (event as CustomEvent).detail as {
      amplitude: number;
      nodes: number;
      frame: number;
    };

    // The score reads the same field the rails do: a busier mesh pings more.
    audio?.observeField(amplitude);

    if (amp) amp.textContent = amplitude.toFixed(2);
    if (nodesEl) nodesEl.textContent = nodes.toLocaleString('en-US');
    if (frameEl) frameEl.textContent = String(frame);

    history.unshift(amplitude);
    if (history.length > rows.length) history.length = rows.length;
    rows.forEach((row, i) => {
      row.textContent = history[i] === undefined ? '–.–––––' : fmt(history[i]);
    });
  });

  // ── Theme ────────────────────────────────────────────────────────────────
  // The theme is already on <html> before this module runs — the inline boot
  // script in the layout put it there ahead of first paint. All this does is
  // flip it, remember the choice, and tell the field, which paints its own
  // ground on a canvas that no stylesheet reaches.
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeState = document.querySelector<HTMLElement>('[data-theme-state]');
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const THEME_COPY = { light: 'switch to dark', dark: 'switch to light' } as const;

  function applyTheme(next: 'dark' | 'light') {
    document.documentElement.dataset.theme = next;
    if (themeState) themeState.textContent = THEME_COPY[next];
    themeMeta?.setAttribute('content', next === 'light' ? '#ffffff' : '#000000');
    document.dispatchEvent(new CustomEvent('fltr:theme', { detail: { theme: next } }));
    try {
      localStorage.setItem('fltr-theme', next);
    } catch {
      // Blocked storage only costs persistence; the page still switches.
    }
  }

  // The boot script has already decided; read from it rather than guessing, so
  // the two never disagree about what is on screen.
  if (themeState) {
    themeState.textContent =
      THEME_COPY[document.documentElement.dataset.theme === 'light' ? 'light' : 'dark'];
  }

  themeBtn?.addEventListener('click', () => {
    applyTheme(document.documentElement.dataset.theme === 'light' ? 'dark' : 'light');
  });

  // ── Motion control ───────────────────────────────────────────────────────
  // The printed word never changes; `aria-pressed` swaps the mark in CSS and
  // the hidden suffix keeps the accessible name honest about the state.
  const motion = document.querySelector<HTMLButtonElement>('[data-motion]');
  const motionState = document.querySelector<HTMLElement>('[data-motion-state]');

  motion?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('fltr:motion-toggle'));
  });

  document.addEventListener('fltr:state', (event) => {
    const { running } = (event as CustomEvent).detail as { running: boolean };
    if (!motion) return;
    // aria-pressed true == motion is held, which is the control's "on" state.
    motion.setAttribute('aria-pressed', String(!running));
    if (motionState) {
      motionState.textContent = running
        ? motion.dataset.stateOff ?? ''
        : motion.dataset.stateOn ?? '';
    }
  });

  document.addEventListener('fltr:unavailable', () => {
    if (!motion) return;
    motion.disabled = true;
    motion.hidden = true;
  });

  // ── Sound ────────────────────────────────────────────────────────────────
  // The synth module is only fetched when someone actually asks for sound, so
  // a visitor who never touches the control pays nothing for it.
  const soundBtn = document.querySelector<HTMLButtonElement>('[data-sound]');
  const soundState = document.querySelector<HTMLElement>('[data-sound-state]');
  const volumeWrap = document.querySelector<HTMLElement>('[data-volume-wrap]');
  const volume = document.querySelector<HTMLInputElement>('[data-volume]');

  let audio: import('../scripts/field-audio').AudioHandle | null = null;

  /** One place that paints the control, so it can never disagree with itself. */
  function paintSound(playing: boolean) {
    if (!soundBtn) return;
    soundBtn.setAttribute('aria-pressed', String(playing));
    if (soundState) {
      soundState.textContent = playing
        ? soundBtn.dataset.stateOn ?? ''
        : soundBtn.dataset.stateOff ?? '';
    }
    if (volumeWrap) volumeWrap.hidden = !playing;
  }

  soundBtn?.addEventListener('click', async () => {
    if (!audio) {
      const { createFieldAudio } = await import('../scripts/field-audio');
      // The score reports back when the browser takes the context away from it
      // — backgrounding on mobile, an interruption on iOS. Without this the
      // plate keeps printing "playing" over silence, which is the same defect
      // as a stop button for motion that cannot happen.
      audio = createFieldAudio(paintSound);
      audio.setVolume(Number(volume?.value ?? 55) / 100);
    }

    const next = !audio.isEnabled();
    await audio.setEnabled(next);
    paintSound(next);
  });

  volume?.addEventListener('input', () => {
    audio?.setVolume(Number(volume.value) / 100);
  });

  // ── Copy ─────────────────────────────────────────────────────────────────
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  const copyText = document.querySelector<HTMLElement>('[data-copy-text]');
  let revert: number | undefined;

  copy?.addEventListener('click', async () => {
    const value = copy.dataset.copy;
    if (!value || !copyText) return;
    try {
      await navigator.clipboard.writeText(value);
    } catch {
      return;
    }
    const original = copyText.textContent ?? '';
    copyText.textContent = copy.dataset.copied ?? original;
    copy.setAttribute('aria-pressed', 'true');
    window.clearTimeout(revert);
    revert = window.setTimeout(() => {
      copyText.textContent = original;
      copy.setAttribute('aria-pressed', 'false');
    }, 1800);
  });
</script>
