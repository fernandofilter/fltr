---
/**
 * The field. Loaded as a deferred island: the wordmark and the contact are
 * static HTML and paint before three.js is even requested, so the page's only
 * two facts never wait on a 3D library.
 *
 * Two exits are mandatory, not decorative:
 *   · no WebGL          → a still bar field in the same material family
 *   · reduced motion    → the mesh resolves once and holds, no loop
 * Plus a visible stop control, because a high-contrast moving field is a
 * photosensitivity risk and not everyone at risk has set an OS preference.
 */
interface Props {
  alt: string;
  staticLabel: string;
}
const { alt, staticLabel } = Astro.props;
---

<div class="field" data-field>
  <canvas class="field__canvas" data-field-canvas role="img" aria-label={alt}></canvas>
  <p class="field__fallback label label--quiet" data-field-fallback hidden>{staticLabel}</p>
</div>

<style>
  .field {
    position: fixed;
    inset: 0;
    z-index: var(--z-field);
    background: var(--ground);
  }

  .field__canvas {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  /* No-WebGL exit: a still field of hairlines at varying pitch. Same world,
     same two values, no pretence of being the mesh it replaces. */
  .field:where([data-webgl='off']) .field__canvas {
    display: none;
  }

  .field:where([data-webgl='off'])::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 46svb;
    background-image: repeating-linear-gradient(
        to right,
        var(--signal) 0 1px,
        transparent 1px 7px
      ),
      repeating-linear-gradient(to right, var(--signal) 0 1px, transparent 1px 23px),
      repeating-linear-gradient(to bottom, var(--signal) 0 1px, transparent 1px 11px);
    mask-image: linear-gradient(to top, #000 0%, #000 22%, transparent 92%);
  }

  .field__fallback {
    position: absolute;
    inset-block-end: calc(var(--gutter) * 2.6);
    inset-inline-start: var(--gutter);
    margin: 0;
  }
</style>

<script>
  import { initWaveField, type FieldHandle } from '../scripts/wave-field';

  const root = document.querySelector<HTMLElement>('[data-field]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-field-canvas]');
  const fallback = document.querySelector<HTMLElement>('[data-field-fallback]');
  if (!root || !canvas) throw new Error('field mount missing');

  let handle: FieldHandle | null = null;

  const emit = (name: string, detail: unknown) =>
    document.dispatchEvent(new CustomEvent(name, { detail }));

  const currentTheme = () =>
    document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';

  function storedDensity(): number | null {
    try {
      const v = localStorage.getItem('fltr-density');
      return v === null ? null : Number(v);
    } catch {
      return null;
    }
  }

  /**
   * The boot screen holds the field's entrance so the mesh does not resolve
   * behind a cover. Tracked as a flag rather than read at boot time because the
   * two race: the screen has a ceiling and can release before the field exists.
   */
  let released = document.documentElement.dataset.booting === undefined;

  async function boot() {
    // The field boots on idle, which is well after a visitor could have hit the
    // theme control. Read the theme at boot rather than assuming the default,
    // or a light-mode page comes up with a black canvas behind it.
    handle = await initWaveField(canvas!, {
      startRunning: true,
      theme: currentTheme(),
      holdEntrance: !released,
      density: storedDensity() ?? undefined,
      onBoot: (stage, value) => emit('fltr:boot', { stage, value }),
      onReadout: (r) => emit('fltr:readout', r),
      // What the machine turned out to hold. The control decides whether to
      // take it; a visitor who already chose is not overruled by a stopwatch.
      onPerf: (medianMs, step) => emit('fltr:density-suggest', { medianMs, step }),
    });

    if (!handle) {
      root!.dataset.webgl = 'off';
      fallback!.hidden = false;
      emit('fltr:unavailable', null);
      return;
    }

    emit('fltr:state', { running: handle.isRunning() });

    document.addEventListener('fltr:motion-toggle', () => {
      if (!handle) return;
      handle.setRunning(!handle.isRunning());
      emit('fltr:state', { running: handle.isRunning() });
    });
  }

  // Registered outside boot(), so a theme switched during the idle window is
  // not dropped on the floor — the handler catches up once the field exists.
  document.addEventListener('fltr:theme', () => handle?.setTheme(currentTheme()));

  // Same reason, and one more: if the boot screen hits its ceiling first there
  // is no handle to release yet, and the flag is what makes the field come up
  // already-released instead of holding a flat plane forever.
  document.addEventListener('fltr:boot-release', () => {
    released = true;
    handle?.releaseEntrance();
  });

  document.addEventListener('fltr:density', (event) => {
    const { step } = (event as CustomEvent).detail as { step: number };
    handle?.setDensity(step);
  });

  // Defer to idle so the library never competes with first paint.
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => void boot(), { timeout: 1800 });
  } else {
    setTimeout(() => void boot(), 1);
  }
</script>
